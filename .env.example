# TestMakon Online Examination Platform - Environment Configuration

# Server Port
PORT=3000

# Application URL
APP_URL="http://localhost:3000"

# Telegram Bot Integration
# 1. Create a bot via @BotFather on Telegram and paste the token here
# 2. Start the bot and get your Telegram Chat ID (via @userinfobot)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ADMIN_CHAT_ID="your_telegram_chat_id_here"
TELEGRAM_BOT_USERNAME="TestMakonBot"

# Supabase / PostgreSQL Configuration (Optional for cloud production, local database is active by default)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# Authentication & Session Security
JWT_SECRET="testmakon-super-secure-production-secret-key-2026"
SESSION_EXPIRY_DAYS=30

# Gemini AI (Optional helper for teachers creating questions)
GEMINI_API_KEY=""
